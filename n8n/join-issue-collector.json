    {
      "parameters": {
        "jsCode": "const existingTasks = $input.all()\n  .map(item => item.json)\n  .filter(task => task && Object.keys(task).length > 0);\n\nconst newTask = $('Create Join Task').first().json;\n\nreturn [{\n  json: {\n    tasks: [...existingTasks, newTask]\n  }\n}];"
      },
