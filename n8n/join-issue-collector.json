    {
      "parameters": {
        "jsCode": "const ai = $json.output || $json;\nconst email = $('Extract Email Data').first().json;\n\nreturn [{\n  json: {\n    id: `task-${Date.now()}`,\n    title: ai.title || email.subject || \"New Issue\",\n    description:\n      `${email.body}\\n\\nDieses Ticket wurde KI-generiert.`,\n    dueDate: ai.deadline || \"\",\n    priority: ai.priority || \"medium\",\n    category: ai.category || \"technical task\",\n    issueType: ai.category || \"technical task\",\n    subtasks: [],\n    completedSubtasks: 0,\n    totalSubtasks: 0,\n    assignedUsers: [],\n    creator: email.sender,\n    creatorType: \"external\",\n    aiGenerated: true,\n    status: \"triage\"\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
