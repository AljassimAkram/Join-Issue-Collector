    {
      "parameters": {
        "jsCode": "/**\n * Extracts the relevant email data for the Issue Collector.\n * @returns {Array} Normalized email data.\n */\nreturn $input.all().map((item) => {\n  const email = item.json;\n\n  return {\n    json: {\n      messageId: email.id || \"\",\n      threadId: email.threadId || \"\",\n      sender: email.From || email.from || \"\",\n      subject: email.Subject || email.subject || \"\",\n      body: email.body || email.text || email.snippet || \"\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        0
      ],
      "id": "8c853702-61fa-41e8-9971-eef1a32e9ca2",
      "name": "Extract Email Data"
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\n\nconst today = $now\n  .setZone('Europe/Berlin')\n  .toFormat('yyyy-MM-dd');\n\nif (data.date !== today) {\n  data.date = today;\n  data.count = 0;\n}\n\nconst count = Number(data.count || 0);\n\nreturn $input.all().map((item) => ({\n  json: {\n    ...item.json,\n    dailyCount: count,\n    limitReached: count >= 10\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
